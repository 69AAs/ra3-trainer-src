<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 第二轮可分拣画风：冷灰蓝表面、提高辅助文字对比、压深主按钮蓝。
         保留既有语义键兼容所有窗口；本组颜色为项目设计值，不再声称逐值取自 Radix。
         对比度依据与回退边界见 REPORT.md 第二轮画风一节。 -->

    <!-- 中性：表面由深到浅（gray1 应用底 → gray6 描边最亮） -->
    <Color x:Key="Gray1">#FF111111</Color>
    <Color x:Key="Gray2">#FF191919</Color>
    <Color x:Key="Gray3">#FF222222</Color>
    <Color x:Key="Gray4">#FF2A2A2A</Color>
    <Color x:Key="Gray5">#FF303030</Color>
    <Color x:Key="Gray6">#FF3A3A3A</Color>
    <Color x:Key="Gray8">#FF606060</Color>
    <Color x:Key="Gray9">#FF6E6E6E</Color>
    <Color x:Key="Gray10">#FF7B7B7B</Color>
    <Color x:Key="Gray11">#FFB4B4B4</Color>
    <Color x:Key="Gray12">#FFEEEEEE</Color>

    <!-- 描边/填充：用白色低透明度，任何表面上都成立 -->
    <Color x:Key="HairlineSoft">#12FFFFFF</Color>
    <Color x:Key="Hairline">#1FFFFFFF</Color>
    <Color x:Key="HoverFill">#0FFFFFFF</Color>
    <Color x:Key="PressFill">#1AFFFFFF</Color>

    <!-- 唯一强调色（只给"可操作/当前选中"） -->
    <Color x:Key="Blue9">#FF0090FF</Color>
    <Color x:Key="Blue10">#FF1D74CF</Color>
    <Color x:Key="Blue8">#FF2870BD</Color>
    <Color x:Key="Blue11">#FF70B8FF</Color>
    <Color x:Key="Blue3">#FF0D2847</Color>

    <!-- 语义（只表意） -->
    <Color x:Key="Green9">#FF30A46C</Color>
    <Color x:Key="Green11">#FF3DD68C</Color>
    <Color x:Key="Red9">#FFE5484D</Color>
    <Color x:Key="Red11">#FFFF9592</Color>
    <Color x:Key="Amber9">#FFFFC53D</Color>
    <Color x:Key="Amber11">#FFFFCA16</Color>

    <!-- ===== 指挥台（游戏修改器专用身份色）：琥珀金主音 + 更深的近黑底 ===== -->
    <Color x:Key="Ink1">#FF0E0E0E</Color>      <!-- 应用底 -->
    <Color x:Key="Ink2">#FF151515</Color>      <!-- 面板底 -->
    <Color x:Key="Ink3">#FF1C1C1C</Color>      <!-- 悬停 -->
    <Color x:Key="Amber">#FFD0021B</Color>     <!-- 主音 -->
    <Color x:Key="AmberHover">#FFE5324A</Color>
    <Color x:Key="AmberText">#FFFF6B7A</Color> <!-- 深底上的强音文字 -->
    <Color x:Key="AmberWash">#00FFFFFF</Color> <!-- 当前行染色底（20% 琥珀） -->
    <Color x:Key="AmberEdge">#55D0021B</Color> <!-- 琥珀描边（40%） -->
</ResourceDictionary>
