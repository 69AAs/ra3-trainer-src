<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ThemeTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 表面：由深到浅表达层级（Fluent 2：层级靠更亮的表面，不靠描边堆叠） -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource Ink1}" />
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="{StaticResource Ink2}" />
    <SolidColorBrush x:Key="PlateBrush" Color="{StaticResource Ink2}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource Ink2}" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="{StaticResource Ink3}" />
    <SolidColorBrush x:Key="PressedSurfaceBrush" Color="{StaticResource Gray4}" />
    <SolidColorBrush x:Key="RowDividerBrush" Color="{StaticResource HairlineSoft}" />
    <SolidColorBrush x:Key="GrooveBrush" Color="{StaticResource HairlineSoft}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource HairlineSoft}" />
    <SolidColorBrush x:Key="BarOverlayBrush" Color="#00000000" />
    <SolidColorBrush x:Key="PlateBorderBrush" Color="{StaticResource Hairline}" />
    <SolidColorBrush x:Key="SteelRingBrush" Color="{StaticResource Hairline}" />
    <SolidColorBrush x:Key="BrushedTileBrush" Color="#00000000" />

    <!-- 文字：四级语义。第二轮 Gray10 / Gray2 静态对比度约 7.37:1，详见报告。 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource Gray12}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Gray11}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource Gray10}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource Gray10}" />

    <!-- 唯一强调色：可操作 / 当前选中 -->
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource Amber}" />
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="{StaticResource AmberHover}" />
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource AmberText}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF1A1206" />
    <SolidColorBrush x:Key="NumeralBrush" Color="{StaticResource Gray12}" />

    <!-- 语义（只表意，不做装饰） -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Green9}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Red11}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Amber11}" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource Red11}" />

    <!-- 功能行开/关指示：小圆点（唯一带颜色的状态元素） -->
    <SolidColorBrush x:Key="LedOnBrush" Color="{StaticResource Green9}" />
    <SolidColorBrush x:Key="LedOffBrush" Color="{StaticResource Gray6}" />

    <!-- 按钮面 -->
    <SolidColorBrush x:Key="Gray6Brush" Color="{StaticResource Gray6}" />
    <SolidColorBrush x:Key="ButtonFaceBrush" Color="{StaticResource Gray4}" />
    <SolidColorBrush x:Key="ButtonFaceHoverBrush" Color="{StaticResource Gray3}" />
    <SolidColorBrush x:Key="ButtonFacePressedBrush" Color="{StaticResource Gray6}" />
    <SolidColorBrush x:Key="PrimaryFaceBrush" Color="{StaticResource Amber}" />
    <SolidColorBrush x:Key="PrimaryFaceHoverBrush" Color="{StaticResource AmberHover}" />
    <SolidColorBrush x:Key="ButtonOnBrush" Color="{StaticResource Gray4}" />
    <SolidColorBrush x:Key="FactionBrush" Color="{StaticResource Gray3}" />
    <SolidColorBrush x:Key="FactionDeepBrush" Color="{StaticResource Gray3}" />

    <!-- 输入 -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource Gray1}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource Hairline}" />
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{StaticResource Amber}" />

    <!-- 仅浮窗用一抹柔和投影（Windows 11 面板观感），主窗不需要 -->
    <DropShadowEffect x:Key="PanelShadow" Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.5" />

    <!-- ===== 指挥台语义：主音=琥珀（取代 AI 蓝指纹），底更黑，发丝线更克制 ===== -->
    <SolidColorBrush x:Key="InkBackgroundBrush" Color="{StaticResource Ink1}" />
    <SolidColorBrush x:Key="InkPanelBrush" Color="{StaticResource Ink2}" />
    <SolidColorBrush x:Key="InkHoverBrush" Color="{StaticResource Ink3}" />
    <SolidColorBrush x:Key="CommandBrush" Color="{StaticResource Amber}" />
    <SolidColorBrush x:Key="CommandHoverBrush" Color="{StaticResource AmberHover}" />
    <SolidColorBrush x:Key="CommandTextBrush" Color="{StaticResource AmberText}" />
    <SolidColorBrush x:Key="CommandWashBrush" Color="{StaticResource AmberWash}" />
    <SolidColorBrush x:Key="CommandEdgeBrush" Color="{StaticResource AmberEdge}" />
</ResourceDictionary>
