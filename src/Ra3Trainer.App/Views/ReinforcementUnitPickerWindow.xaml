<Window Icon="pack://application:,,,/Ra3Trainer.App;component/Assets/app.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Ra3Trainer.App.Views.ReinforcementUnitPickerWindow" Background="{StaticResource PlateBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" Title="选择增援单位" Width="640" Height="430" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner" FontSize="12" ToolTipService.IsEnabled="False" ContextMenuService.IsEnabled="False">
  <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource GrooveBrush}" BorderThickness="1" Padding="12">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="单位库 / 搜索" FontSize="18" Margin="0,0,0,8"/>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="导入文件" Command="{Binding ImportCommand}"/>
            <Button Content="确认" Command="{Binding ConfirmCommand}"/>
            <Button Content="取消" Command="{Binding CancelCommand}"/>
          </StackPanel>
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <CheckBox IsChecked="{Binding ShowProps}" Content="显示地图杂物（箱子 / 信标 / 中立设施 / 平民建筑）" Margin="0,8"/>
        <CheckBox IsChecked="{Binding ShowAllModUnits}" Content="显示全部 mod 单位（其他 mod 的单位会带来源标注）" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <Expander Header="目录管理" IsExpanded="False">
          <StackPanel>
            <Button Content="扫描单位代号" Command="{Binding Owner.DataContext.ScanUnitTypesCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <TextBlock Text="{Binding Owner.DataContext.StatusMessage, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" FontSize="11"/>
          </StackPanel>
        </Expander>
      </StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="164"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
          <ListBox DockPanel.Dock="Top" ItemsSource="{Binding ModSources}" SelectedItem="{Binding SelectedSource}" MaxHeight="82"/>
          <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <ListBox Grid.Column="1" ItemsSource="{Binding FilteredUnits}" SelectedItem="{Binding SelectedUnit}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="2,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="88"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Text="{Binding ModBadge}" FontSize="11" Margin="8,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding CodeText}" FontSize="11"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="2,5"/>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
        </ListBox>
      </Grid>
    </DockPanel>
  </Border>
</Window>
